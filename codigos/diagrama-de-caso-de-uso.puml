@startuml diagrama-de-caso-de-uso
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
title Diagrama de Caso de Uso - Sistema de Gestão das Olimpíadas (SGO)

actor "Administrador" as Admin
actor "Organizador" as Org
actor "Árbitro" as Arb
actor "Atleta" as Atl
actor "Público" as Pub

rectangle "Sistema de Gestão das Olimpíadas (SGO)" {

  usecase "Cadastrar Competição" as UC01
  usecase "Editar Competição" as UC02
  usecase "Inscrever Atleta" as UC03
  usecase "Cadastrar País" as UC04
  usecase "Cadastrar Local" as UC05
  usecase "Alocar Local" as UC06
  usecase "Verificar Conflito de Horário" as UC07
  usecase "Registrar Resultado" as UC08
  usecase "Determinar Medalhistas" as UC09
  usecase "Gerar Relatório de Medalhas" as UC10
  usecase "Consultar Quadro de Medalhas" as UC11
  usecase "Autenticar Usuário" as UC12
  usecase "Validar Inscrição" as UC13
}

' Relações do Administrador
Admin --> UC01
Admin --> UC02
Admin --> UC04
Admin --> UC05
Admin --> UC12

' Relações do Organizador
Org --> UC03
Org --> UC06
Org --> UC10
Org --> UC12

' Relações do Árbitro
Arb --> UC08
Arb --> UC12

' Relações do Atleta
Atl --> UC03
Atl --> UC11

' Relações do Público
Pub --> UC11

' Relações de include/extend
UC06 ..> UC07 : <<include>>
UC03 ..> UC13 : <<include>>
UC08 ..> UC09 : <<include>>
UC10 ..> UC09 : <<include>>
UC01 ..> UC12 : <<include>>
UC02 ..> UC12 : <<include>>
UC06 ..> UC12 : <<include>>
UC08 ..> UC12 : <<include>>

@enduml
